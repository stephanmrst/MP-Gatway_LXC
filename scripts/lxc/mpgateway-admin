#!/bin/sh
set -eu

DROPIN="/etc/ssh/sshd_config.d/90-mp-gateway-root-password.conf"

escape_json() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/[[:cntrl:]]/ /g'
}

reply() {
    printf '{"ok":%s,"enabled":%s,"available":%s,"password_set":%s,"message":"%s"}\n' \
        "$1" "$2" "$3" "$4" "$(escape_json "$5")"
}

password_set() {
    passwd -S root 2>/dev/null | grep -q '^root P '
}

enabled() {
    [ -f "$DROPIN" ] &&
    grep -Eq '^[[:space:]]*PermitRootLogin[[:space:]]+yes([[:space:]]|$)' "$DROPIN"
}

reload_ssh() {
    /usr/sbin/sshd -t || return 1
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null
}

write_mode() {
    mode="$1"
    mkdir -p /etc/ssh/sshd_config.d

    if [ "$mode" = "enable" ]; then
        cat >"$DROPIN" <<'EOF'
# Managed by MP-Gateway.
Match all
PermitRootLogin yes
PasswordAuthentication yes
EOF
    else
        cat >"$DROPIN" <<'EOF'
# Managed by MP-Gateway.
Match all
PermitRootLogin prohibit-password
PasswordAuthentication yes
EOF
    fi

    chown root:root "$DROPIN"
    chmod 0644 "$DROPIN"
    reload_ssh
}

status() {
    command -v sshd >/dev/null 2>&1 || {
        reply false false false false "OpenSSH-Server ist nicht installiert"
        exit 0
    }
    en=false
    pw=false
    enabled && en=true
    password_set && pw=true
    reply true "$en" true "$pw" "SSH-Verwaltung verfügbar"
}

case "${1:-}:${2:-}" in
    ssh-root-password:status) status ;;
    ssh-root-password:enable)
        if ! password_set; then
            reply false false true false "Für root ist kein Passwort gesetzt"
            exit 1
        fi
        write_mode enable
        reply true true true true "Root-Login per SSH-Passwort ist aktiviert"
        ;;
    ssh-root-password:disable)
        write_mode disable
        pw=false; password_set && pw=true
        reply true false true "$pw" "Root-Login per SSH-Passwort ist deaktiviert"
        ;;
    *)
        reply false false false false "Unbekannte Aktion"
        exit 2
        ;;
esac
