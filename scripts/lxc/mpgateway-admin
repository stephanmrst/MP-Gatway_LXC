#!/bin/sh
set -eu

SSHD_DROPIN="/etc/ssh/sshd_config.d/90-mp-gateway-root-password.conf"

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/[[:cntrl:]]/ /g'
}

reply() {
    ok="$1"; enabled="$2"; available="$3"; password_set="$4"; message="$5"
    printf '{"ok":%s,"enabled":%s,"available":%s,"password_set":%s,"message":"%s"}\n' \
        "$ok" "$enabled" "$available" "$password_set" "$(json_escape "$message")"
}

root_password_set() {
    state="$(passwd -S root 2>/dev/null | awk '{print $2}' || true)"
    [ "$state" = "P" ]
}

reload_ssh() {
    /usr/sbin/sshd -t || return 1
    if command -v systemctl >/dev/null 2>&1; then
        systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || return 1
    else
        service ssh reload 2>/dev/null || return 1
    fi
}

restore_previous() {
    previous="$1"
    if [ "$previous" = "__MPGW_MISSING__" ]; then
        rm -f "$SSHD_DROPIN"
    else
        printf '%s\n' "$previous" > "$SSHD_DROPIN"
        chmod 0644 "$SSHD_DROPIN"
    fi
    /usr/sbin/sshd -t >/dev/null 2>&1 && {
        systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
    }
}

status_action() {
    if [ ! -x /usr/sbin/sshd ]; then
        reply false false false false "OpenSSH-Server ist nicht installiert"
        return 0
    fi

    enabled=false
    if [ -f "$SSHD_DROPIN" ] && grep -Eq '^[[:space:]]*PermitRootLogin[[:space:]]+yes([[:space:]]|$)' "$SSHD_DROPIN"; then
        enabled=true
    fi
    password_set=false
    root_password_set && password_set=true
    reply true "$enabled" true "$password_set" "SSH-Verwaltung verfügbar"
}

enable_action() {
    install -d -m 0755 /etc/ssh/sshd_config.d
    previous="__MPGW_MISSING__"
    [ -f "$SSHD_DROPIN" ] && previous="$(cat "$SSHD_DROPIN")"

    cat > "$SSHD_DROPIN" <<'DROPIN'
# Managed by MP-Gateway. Manual changes may be overwritten.
PermitRootLogin yes
Match User root
    PasswordAuthentication yes
DROPIN
    chmod 0644 "$SSHD_DROPIN"

    if ! reload_ssh; then
        restore_previous "$previous"
        reply false false true false "SSH-Konfiguration war ungültig und wurde zurückgerollt"
        return 1
    fi

    password_set=false
    root_password_set && password_set=true
    if [ "$password_set" = true ]; then
        reply true true true true "Root-Login per SSH-Passwort ist aktiviert"
    else
        reply true true true false "Zugriff aktiviert, aber für root ist noch kein Passwort gesetzt"
    fi
}

disable_action() {
    install -d -m 0755 /etc/ssh/sshd_config.d
    previous="__MPGW_MISSING__"
    [ -f "$SSHD_DROPIN" ] && previous="$(cat "$SSHD_DROPIN")"

    cat > "$SSHD_DROPIN" <<'DROPIN'
# Managed by MP-Gateway. SSH-Schlüssel bleiben für root erlaubt.
PermitRootLogin prohibit-password
Match User root
    PasswordAuthentication no
DROPIN
    chmod 0644 "$SSHD_DROPIN"

    if ! reload_ssh; then
        restore_previous "$previous"
        reply false true true false "SSH-Konfiguration war ungültig und wurde zurückgerollt"
        return 1
    fi

    password_set=false
    root_password_set && password_set=true
    reply true false true "$password_set" "Root-Login per SSH-Passwort ist deaktiviert; SSH-Schlüssel bleiben erlaubt"
}

case "${1:-}" in
    ssh-root-password)
        case "${2:-}" in
            status) status_action ;;
            enable) enable_action ;;
            disable) disable_action ;;
            *) reply false false true false "Unbekannte SSH-Aktion"; exit 2 ;;
        esac
        ;;
    *)
        reply false false false false "Unbekannte Aktion"
        exit 2
        ;;
esac
